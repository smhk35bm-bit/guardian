<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Guardian" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/guardian_primary</item>
        <item name="colorPrimaryDark">@color/guardian_primary_dark</item>
        <item name="colorSecondary">@color/guardian_accent</item>
        <item name="android:colorBackground">@color/guardian_background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/guardian_primary_dark</item>
        <item name="android:windowBackground">@color/guardian_background</item>
    </style>

    <style name="GuardianSectionTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/guardian_text_primary</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="GuardianBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/guardian_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

</resources>
