    <string name="notif_text">Monitoring \"%1$s\" is running, data is sent to the parent dashboard</string>

    <!-- ================= Enrollment ================= -->
    <string name="enroll_title">Pair this device</string>
    <string name="enroll_disclosure">Important notice: this app collects the current location, app usage, the call log, text messages, screenshots and camera photos, and sends them to the parent dashboard on the parent server.\n\nTerms of use:\n• The device is paired with the explicit consent of the parent.\n• A permanent, non dismissable notification stays in the status bar while the app runs.\n• The user can open the app at any time to see the monitoring status, stop the service and unpair the device.\n• The app contains no mechanism to hide itself or to hide its traces.</string>
    <string name="enroll_server_url">Parent server address</string>
    <string name="enroll_server_hint">https://vps.example.com/api</string>
    <string name="enroll_code">Pairing code (8 digits)</string>
    <string name="enroll_button">Pair device</string>
    <string name="enroll_progress">Pairing…</string>
    <string name="enroll_privacy_note">The launcher name of the app is \"Guardian — Parental Monitoring\" and it is shown in the status bar while it runs.</string>

