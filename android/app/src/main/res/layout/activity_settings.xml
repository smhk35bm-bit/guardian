<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/guardian_primary_dark"
        android:padding="14dp"
        android:text="@string/settings_title"
        android:textColor="@color/guardian_notification_icon"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/GuardianSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_url" />

            <TextView
                style="@style/GuardianBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_url_desc"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true"
                android:textDirection="ltr"
                android:gravity="start" />

            <TextView
                style="@style/GuardianSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_device_name" />

            <TextView
                style="@style/GuardianBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_device_name_desc"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/deviceNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_save" />

            <TextView
                style="@style/GuardianSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_camera_section" />

            <TextView
                style="@style/GuardianBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_camera_note"
                android:textSize="13sp" />

            <TextView
                style="@style/GuardianSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_queue" />

            <Button
                android:id="@+id/clearQueueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_queue" />

            <Button
                android:id="@+id/unpairButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_unpair" />

        </LinearLayout>
    </ScrollView>

    <TextView
        style="@style/GuardianSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/section_collectors" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/collectorList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp" />

</LinearLayout>
