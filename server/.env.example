# ============================================
#  Guardian Parental Control - Server config
#  انسخ هذا الملف إلى .env وعدّل القيم
# ============================================

# المنفذ الذي يعمل عليه السيرفر داخلياً
PORT=3000

# العنوان العام — اختياري.
# إن تُرك فارغاً يستنتجه الخادم من الطلب نفسه (يعمل على Render بلا إعداد).
# اضبطه فقط عند استخدام نطاق مخصّص: https://guardian.example.com
PUBLIC_URL=

# مفتاح توقيع التوكنات (ولّد مفتاحاً قوياً):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS

# مدة صلاحية توكن الأب (بالأيام)
PARENT_TOKEN_DAYS=30

# مدة صلاحية توكن الجهاز (بالأيام)
DEVICE_TOKEN_DAYS=365

# ---------------------------------------------------------------
#  طبقة التخزين
# ---------------------------------------------------------------
# قاعدة البيانات:
#   sqlite = ملف محلي على القرص (VPS عادي / تشغيل محلي)
#   libsql = قاعدة بعيدة عبر HTTP (Turso) — للخدمات المجانية
#            التي تمسح القرص عند كل نشر (Render وأمثالها)
DB_DRIVER=sqlite

# رابط Turso (من: turso db show <name> --http-url)
# LIBSQL_URL=https://my-db-myorg.turso.io
# LIBSQL_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# مكان الوسائط (الصور ولقطات الشاشة):
#   file = داخل مجلد uploads على القرص
#   db   = داخل قاعدة البيانات على شكل أجزاء (media_blobs)
# الافتراضي: db عند استخدام libsql، و file عند استخدام sqlite
MEDIA_DRIVER=file

# حجم جزء الملف الواحد عند التخزين في القاعدة (بايت)
MEDIA_CHUNK_BYTES=131072

# مسار قاعدة البيانات والملفات المرفوعة (يُستخدم مع DB_DRIVER=sqlite)
DATA_DIR=./data
UPLOAD_DIR=./uploads

# الحد الأقصى لحجم الملف المرفوع (bytes) — 10MB
MAX_UPLOAD_BYTES=10485760

# طلبات /api/auth لكل IP
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MIN=15

# طلبات الجهاز في الدقيقة
DEVICE_RATE_LIMIT=600

# تفعيل وضع التطوير (يطبع أخطاء مفصلة)
NODE_ENV=production
