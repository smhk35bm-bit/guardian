[Unit]
Description=Guardian Parental Control — API + parent dashboard
Documentation=https://github.com/your-user/guardian
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guardian
Group=guardian
WorkingDirectory=/opt/guardian/server
EnvironmentFile=/opt/guardian/server/.env
ExecStart=/usr/bin/node /opt/guardian/server/src/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# Hardening — the service only needs to write inside its own directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/guardian/server/data /opt/guardian/server/uploads
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

StandardOutput=journal
StandardError=journal
SyslogIdentifier=guardian

[Install]
WantedBy=multi-user.target
